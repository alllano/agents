# Line endings are pinned per file type. Without this, a checkout on a machine
# with core.autocrlf=true rewrites setup.sh with CRLF, and every POSIX shell
# then fails on the shebang with an unhelpful bad-interpreter error.

* text=auto eol=lf

*.sh   text eol=lf
*.ps1  text eol=crlf
*.md   text eol=lf

LICENSE  text eol=lf
.gitkeep text eol=lf
